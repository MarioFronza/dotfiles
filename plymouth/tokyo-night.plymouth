[Plymouth Theme]
Name=Tokyo Night
Description=Tokyo Night themed splash/LUKS unlock screen.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/tokyo-night
ScriptFile=/usr/share/plymouth/themes/tokyo-night/tokyo-night.script
ConsoleLogBackgroundColor=0x1a1b26
MonospaceFont=JetBrainsMono Nerd Font Mono 10
Font=JetBrainsMono Nerd Font Mono 10
