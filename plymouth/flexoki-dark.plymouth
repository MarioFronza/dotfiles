[Plymouth Theme]
Name=Flexoki Dark
Description=Flexoki Dark themed splash/LUKS unlock screen.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/flexoki-dark
ScriptFile=/usr/share/plymouth/themes/flexoki-dark/flexoki-dark.script
ConsoleLogBackgroundColor=0x282726
MonospaceFont=JetBrainsMono Nerd Font Mono 10
Font=JetBrainsMono Nerd Font Mono 10
